# Supabase → Connect → ORMs/Drizzle. Pooler em modo transaction (porta 6543) pro app na Vercel.
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Conexão direta (porta 5432), só pras migrations. Se ficar vazia, usa DATABASE_URL.
DATABASE_URL_DIRECT=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Auth.js. Gere com: npx auth secret
AUTH_SECRET=

# E-mail de "esqueci a senha" (Resend). Sem a chave, o link aparece no terminal.
RESEND_API_KEY=
EMAIL_FROM=pqp, era pra hoje? <nao-responda@seudominio.com>

# Web Push. Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Segredo que o pg_cron manda no header Authorization.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
