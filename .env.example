# Supabase → Project Settings → API. Nada aqui vai pro browser (sem NEXT_PUBLIC_).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só o cron de push usa. Ignora RLS: nunca exponha.
SUPABASE_SECRET_KEY=sb_secret_...

# Web Push. Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Segredo que o pg_cron manda no header Authorization. Gere com: openssl rand -hex 32
CRON_SECRET=
